# ============================================
# Website TKJT - Environment Variables
# ============================================
# Copy file ini ke .env dan isi nilainya.
# JANGAN commit file .env ke repository.
#
# Semua variabel di bawah dibaca SERVER, bukan browser. Browser tidak pernah
# memanggil Supabase langsung, semuanya lewat /api/*.

# --- WAJIB ---

# Kunci penanda tangan token sesi. Minimal 16 karakter.
# Tanpa ini, login dan semua endpoint tulis balas 503.
AUTH_SECRET=

# Kredensial login admin dan tamu.
ADMIN_USER=
ADMIN_PASS=
GUEST_USER=
GUEST_PASS=

# --- SUPABASE (opsional saat lokal, wajib saat deploy ke Vercel) ---
#
# Tanpa Supabase, data disimpan di database.json. Itu cukup untuk pengembangan
# lokal, tetapi TIDAK bekerja di Vercel karena filesystem-nya read-only.
#
# Ambil nilainya di: Supabase Dashboard > Project Settings > API

SUPABASE_URL=

# service_role key. Wajib untuk operasi tulis, karena RLS hanya mengizinkan
# tulis lewat peran ini. Jangan pernah kirim nilai ini ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# anon/publishable key. Opsional. Hanya dipakai sebagai fallback BACA-SAJA
# kalau service_role key belum diisi.
SUPABASE_PUBLISHABLE_KEY=

# --- OPSIONAL ---

# Rate limit login. Nilai di bawah adalah default kalau dibiarkan kosong.
# AUTH_RATE_MAX=5
# AUTH_RATE_WINDOW_MS=60000